theme_override_fonts/bold_font = SubResource("FontVariation_l2x7e")
theme_override_font_sizes/normal_font_size = 20
theme_override_font_sizes/bold_font_size = 30
bbcode_enabled = true
text = "[b]0.0.2-Alpha[/b]
- Игра портирована на мобильные Android-устройства.
- Изменена текстура дивана"

[connection signal="pressed" from="VBoxContainer/PlayButton" to="." method="_on_play_button_pressed"]
[connection signal="pressed" from="VBoxContainer/PatchNoteButton" to="." method="_on_patch_note_button_pressed"]
[connection signal="pressed" from="VBoxContainer/QuitButton" to="." method="_on_quit_button_pressed"]
[connection signal="pressed" from="ColorRect/BackButton" to="." method="_on_back_button_pressed"]
